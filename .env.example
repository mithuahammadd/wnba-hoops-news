# --- OPTIONAL: Google Gemini API (Obtain from Google AI Studio: https://aistudio.google.com/) ---
# Used exclusively on the server side to generate pending news drafts from RSS metadata.
# When omitted, AI draft generation is gracefully disabled while manual drafting remains active.
GEMINI_API_KEY=AQ.Ab8RN6I7N_NLdHFwFlQTWUNuCy2YqYbx58RfdL7EB0cZXQjVNA

# --- OPTIONAL: External WNBA Sports Data Provider ---
# Supported values for SPORTS_DATA_PROVIDER: "manual" (default Supabase DB), "espn_documented", "sportradar", "demo"
# When no external API key is configured, the platform uses verified manual database entries
# or displays an honest data-availability banner without fabricating live scores.
SPORTS_DATA_PROVIDER=manual
SPORTS_API_KEY=
SPORTS_API_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/wnba

# --- REQUIRED FOR SCHEDULED AUTOMATION: Vercel Cron Secret ---
# Generate with: openssl rand -hex 32
CRON_SECRET=your-secure-cron-secret-token
